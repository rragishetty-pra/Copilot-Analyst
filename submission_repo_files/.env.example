# Copilot Analyst — copy this to .env and fill in your values:
#   cp .env.example .env        (Windows: copy .env.example .env)

# REQUIRED — Anthropic API key from console.anthropic.com (each user needs their own)
ANTHROPIC_API_KEY=

# RECOMMENDED — encrypts source PDFs in data/raw/. Leave blank to auto-generate
# data/.keyfile on first run, or create one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DOC_ENCRYPTION_KEY=

# OPTIONAL — Google Drive folder ID (Drive source is currently unused)
DRIVE_FOLDER_ID=
